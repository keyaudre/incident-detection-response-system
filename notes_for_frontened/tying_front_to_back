import { LineChart, Line, XAxis, YAxis, Tooltip, ResponsiveContainer } from "recharts";

function LineChartComponent({ incidents = [] }) {

  const grouped = {};

  incidents.forEach(i => {
    const date = i.detected_at;
    grouped[date] = (grouped[date] || 0) + 1;
  });

  const data = Object.keys(grouped).map(date => ({
    date,
    count: grouped[date]
  }));

  return (
    <ResponsiveContainer width="100%" height="100%">
      <LineChart data={data}>
        <XAxis dataKey="date" />
        <YAxis />
        <Tooltip />
        <Line dataKey="count" stroke="#3b82f6" />
      </LineChart>
    </ResponsiveContainer>
  );
}

